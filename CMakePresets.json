{
  "version": 3,
  "configurePresets": [
    {
      "name": "windows-x64",
      "displayName": "Windows x64",
      "generator": "Visual Studio 16 2019",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build/windows-x64",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "BUILD_TESTING": "ON"
      }
    },
    {
      "name": "windows-x64-debug",
      "displayName": "Windows x64 (Debug)",
      "inherits": "windows-x64",
      "binaryDir": "${sourceDir}/build/windows-x64-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "linux-x64",
      "displayName": "Linux x64",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/linux-x64",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "BUILD_TESTING": "ON"
      }
    },
    {
      "name": "linux-x64-debug",
      "displayName": "Linux x64 (Debug)",
      "inherits": "linux-x64",
      "binaryDir": "${sourceDir}/build/linux-x64-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "macos-arm64",
      "displayName": "macOS arm64",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/macos-arm64",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_OSX_ARCHITECTURES": "arm64",
        "BUILD_TESTING": "ON"
      }
    },
    {
      "name": "macos-x64",
      "displayName": "macOS x86_64",
      "inherits": "macos-arm64",
      "binaryDir": "${sourceDir}/build/macos-x64",
      "cacheVariables": {
        "CMAKE_OSX_ARCHITECTURES": "x86_64"
      }
    }
  ],
  "buildPresets": [
    { "name": "windows-x64",       "configurePreset": "windows-x64",       "configuration": "Release" },
    { "name": "windows-x64-debug", "configurePreset": "windows-x64-debug", "configuration": "Debug" },
    { "name": "linux-x64",         "configurePreset": "linux-x64" },
    { "name": "linux-x64-debug",   "configurePreset": "linux-x64-debug" },
    { "name": "macos-arm64",       "configurePreset": "macos-arm64" },
    { "name": "macos-x64",         "configurePreset": "macos-x64" }
  ],
  "testPresets": [
    { "name": "windows-x64",       "configurePreset": "windows-x64",       "configuration": "Release", "output": {"outputOnFailure": true} },
    { "name": "linux-x64",         "configurePreset": "linux-x64",         "output": {"outputOnFailure": true} },
    { "name": "macos-arm64",       "configurePreset": "macos-arm64",       "output": {"outputOnFailure": true} }
  ]
}
